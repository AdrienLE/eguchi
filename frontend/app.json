{
  "expo": {
    "name": "Eguchi Ear Trainer",
    "slug": "eguchi-ear-trainer",
    "version": "1.0.0",
    "runtimeVersion": { "policy": "fingerprint" },
    "updates": {
      "url": "https://u.expo.dev/5a909b9d-6999-431c-ab81-a53187d7575a",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": { "expo-channel-name": "production" }
    },
    "orientation": "default",
    "icon": "./assets/images/eguchi/ui/app-icon.png",
    "scheme": "eguchieartrainer",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "assetBundlePatterns": ["assets/audio/**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eguchi.app",
      "infoPlist": {
        "UIUserInterfaceStyle": "Light"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/eguchi/ui/app-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.eguchi.app",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/eguchi/ui/app-icon.png"
    },
    "plugins": [
      "./plugins/withOptionalRemotePush",
      "./plugins/withFmtXcode26Fix",
      [
        "expo-router",
        {
          "origin": "https://eguchi-api-production.up.railway.app"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/eguchi/ui/app-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-notifications",
        {
          "mode": "production",
          "color": "#E53935"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5a909b9d-6999-431c-ab81-a53187d7575a"
      },
      "remotePushEnabled": true,
      "remotePushPlatforms": ["ios"]
    },
    "owner": "adrienle"
  }
}
